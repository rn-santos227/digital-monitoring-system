# -----------------------------
# Nuxt + Supabase runtime
# -----------------------------
# Public Supabase project URL
# Nuxt module reads SUPABASE_URL; app/server utils also support NUXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public (anon/publishable) key
# Nuxt module reads SUPABASE_KEY; app/server utils also support NUXT_PUBLIC_SUPABASE_KEY.
SUPABASE_KEY=your-supabase-anon-key
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# Optional aliases used in some setups
# SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# NUXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-side service role key (only for trusted server contexts)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------
# Self-hosted Supabase Storage (S3)
# -----------------------------
# Enable these only when running self-hosted Supabase Storage with an S3-compatible backend.
# Reference: https://supabase.com/docs/guides/self-hosting/self-hosted-s3

# Region used by the Storage service and S3 protocol endpoint.
REGION=us-east-1

# Credentials for Supabase Storage S3-compatible protocol endpoint (/storage/v1/s3).
S3_PROTOCOL_ACCESS_KEY_ID=your-s3-protocol-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=your-s3-protocol-access-key-secret

# Configure Supabase Storage to persist objects in an S3 backend (AWS, MinIO, R2, etc.).
STORAGE_BACKEND=s3
GLOBAL_S3_BUCKET=your-storage-bucket-name
AWS_ACCESS_KEY_ID=your-aws-or-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-or-s3-secret-access-key

# Required for non-AWS S3 providers (MinIO, Cloudflare R2, Wasabi, etc.).
# GLOBAL_S3_ENDPOINT=https://your-s3-endpoint
# GLOBAL_S3_PROTOCOL=https
# GLOBAL_S3_FORCE_PATH_STYLE=true

# Optional: disable S3 object tagging for providers that don't support it (for example R2).
# TUS_ALLOW_S3_TAGS=false
