# -----------------------------
# Nuxt + Supabase runtime
# -----------------------------
# Public Supabase project URL
# Nuxt module reads SUPABASE_URL; app/server utils also support NUXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public (anon/publishable) key
# Nuxt module reads SUPABASE_KEY; app/server utils also support NUXT_PUBLIC_SUPABASE_KEY.
SUPABASE_KEY=your-supabase-anon-key
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# Optional aliases used in some setups
# SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# NUXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-side service role key (only for trusted server contexts)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------
# OWASP-aligned HTTP protections
# -----------------------------
# Comma-separated additional browser origins allowed to send API mutations.
# Same-origin requests and non-browser clients without an Origin header remain supported.
NUXT_SECURITY_ALLOWED_ORIGINS=https://monitoring.example.mil
NUXT_SECURITY_API_RATE_LIMIT=120
NUXT_SECURITY_API_RATE_LIMIT_WINDOW_MS=60000
# Includes multipart framing around the validated 10 MiB maximum file size.
NUXT_SECURITY_MAX_REQUEST_BODY_BYTES=11534336

# -----------------------------
# Supabase Storage S3 protocol connection
# -----------------------------
# These are used by server-side file helpers when connecting to
# Supabase Storage's S3-compatible endpoint.
# Reference: https://supabase.com/docs/guides/storage/s3/authentication

# Example: https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3

# Bucket for attachments (required by S3 resolver and file upload helpers).
SUPABASE_STORAGE_BUCKET=record-attachments

# Region and credentials for S3 protocol clients.
REGION=us-east-1
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
S3_PROTOCOL_ACCESS_KEY_ID=your-s3-protocol-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=your-s3-protocol-access-key-secret

# Optional aliases supported by existing file-management helpers.
# DMS_STORAGE_BUCKET=record-attachments
# GLOBAL_S3_BUCKET=record-attachments
