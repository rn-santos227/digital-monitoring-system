# -----------------------------
# Nuxt + Supabase runtime
# -----------------------------
# Public Supabase project URL
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public (anon/publishable) key
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# Optional server-side service role key (only for trusted server contexts)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------
# Optional seed settings
# -----------------------------
# These values are NOT read directly by SQL seed scripts.
# Before running seed.sql, map these into DB settings:
#   app.default_user_email
#   app.default_user_password
#   app.default_user_username
#   app.default_user_full_name

DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=change-me
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_FULL_NAME=Default Administrator
